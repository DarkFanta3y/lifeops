# 仅填写需要覆盖的配置；优先级：环境变量 > .env > 代码默认值。
# 完整参数与默认值见 src/lifeops/core/config.py；MCP 用法见 README.md。

# LLM：密钥必填，模型与端点须匹配供应商
LLM_API_KEY=
LLM_MODEL=glm-4-flash
LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4

# Docker MySQL：请分别填写随机密码，Compose 会把数据库连接注入后端。
LIFEOPS_MYSQL_PASSWORD=
LIFEOPS_MYSQL_ROOT_PASSWORD=
# 本机直接运行后端时填写 mysql://lifeops:数据库密码@127.0.0.1:3307/lifeops
LIFEOPS_DATABASE_URL=

# Chroma 独立服务：本机通过 8004 连接，Compose 自动覆盖为 chroma:8000。
# HOST 留空时使用 CHROMA_PATH 中的嵌入式向量库，仅用于本地兼容。
LIFEOPS_RAG_CHROMA_HOST=127.0.0.1
LIFEOPS_RAG_CHROMA_PORT=8004
# BM25、父文档和切片缓存目录（服务模式下不保存向量）。
# LIFEOPS_RAG_CHROMA_PATH=.lifeops/chroma

# 按需取消注释：网络搜索、知识库、工具审批
# SERPAPI_API_KEY=
# LIFEOPS_RAG_DATA_DIRS=.lifeops/knowledge  # 多个目录用英文逗号分隔
# LIFEOPS_TOOL_POLICY_PERMISSION_MODE=default  # default / accept_edits / yolo

# 模型调优：窗口大小按模型设置；不支持 include_usage 时关闭用量统计
# LLM_MAX_TOKENS=4096
# LLM_STREAM_USAGE=true
# LIFEOPS_CONTEXT_MAX_CONTEXT_TOKENS=200000

# 本地后端默认 127.0.0.1:8081；端口须与 web/.env.local 的 VITE_API_URL 一致
# LIFEOPS_WEB_PORT=8081
# Docker Compose 自动覆盖监听地址、端口（8082）和路径，宿主机无需另设。

# MCP：按需启用预设，或用 JSON 配置自定义 Server
# LIFEOPS_MCP_PRESETS=context7,playwright,memory,sequential_thinking,filesystem
# LIFEOPS_MCP_SERVERS={}
# LIFEOPS_FILESYSTEM_MCP_ROOTS=  # 为空时默认项目根目录

# GitHub / Google Workspace MCP 凭据与 OAuth 配置（启用对应集成时填写）
# GITHUB_PERSONAL_ACCESS_TOKEN=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# OAUTHLIB_INSECURE_TRANSPORT=1  # 仅用于本地 HTTP OAuth 回调
# GOOGLE_MCP_CREDENTIALS_DIR=
# LIFEOPS_GOOGLE_WORKSPACE_MCP_PERMISSIONS=gmail:drafts  # 真实发送改为 gmail:send
# LIFEOPS_GOOGLE_WORKSPACE_MCP_TOOL_TIER=core
